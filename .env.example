# SkiNav environment variables — TEMPLATE.
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must NEVER be committed. Only this `.env.example` (no real secrets) is tracked.
#
# Expo exposes vars prefixed EXPO_PUBLIC_* to the app at runtime; anything
# without that prefix stays build/CI-only (keep true secrets unprefixed).

# --- Sentry (crash/error logging — planned, not wired up yet) ---
# Runtime DSN read by the app. Not highly sensitive, but kept out of the repo.
EXPO_PUBLIC_SENTRY_DSN=

# Secret: used only at build time to upload source maps. NEVER commit the real
# value; set it in your local .env and in CI secrets.
SENTRY_AUTH_TOKEN=

# --- Cloud backend (Supabase — future) ---
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
