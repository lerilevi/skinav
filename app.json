{
  "expo": {
    "name": "SkiNav",
    "slug": "skinav",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "skinav",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#071525"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skinav.app"
    },
    "android": {
      "package": "com.skinav.app",
      "adaptiveIcon": {
        "backgroundColor": "#071525"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
